issn = {10298479},
journal = {Journal of High Energy Physics},
month = {jan},
number = {1},
pages = {53},
title = {{Thermal phase transition in Yang-Mills matrix model}},
url = {http://arxiv.org/abs/1909.04592},
volume = {2020},
year = {2019}
}
