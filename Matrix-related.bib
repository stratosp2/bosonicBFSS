issn = {10298479},
journal = {Journal of High Energy Physics},
keywords = {AdS-CFT Correspondence,D-branes,Gauge Symmetry,M(atrix) Theories},
number = {4},
title = {{To gauge or not to gauge?}},
volume = {2018},
year = {2018}
}
